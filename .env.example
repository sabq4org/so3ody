# ===== سعودي سبورت 2.0 — متغيّرات البيئة =====
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية (‏.env.local غير متعقّب في Git)

# قاعدة بيانات Neon Postgres (تخزين ردود استطلاع /survey)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# ===== لوحة الإدارة (/admin) =====
# كلمة مرور الدخول للوحة الإدارة (إلزامية لتفعيل اللوحة)
ADMIN_PASSWORD="اختر-كلمة-مرور-قوية"
# سرّ توقيع كوكي الجلسة (اختياري — يُشتق من ADMIN_PASSWORD إن تُرك فارغًا)
SESSION_SECRET=""

# ===== الذكاء الاصطناعي (متوافق مع OpenAI) =====
# بدون AI_API_KEY يبقى زر التحليل معطّلاً بحالة واضحة
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"
AI_PROVIDER="openai"

# ملاحظة سابقة: SURVEY_ADMIN_TOKEN لم يعد يُستخدم لصفحة النتائج القديمة (استُبدلت بجلسة).
# يبقى مقبولًا كبديل لكلمة مرور الإدارة إن لم يُضبط ADMIN_PASSWORD.
